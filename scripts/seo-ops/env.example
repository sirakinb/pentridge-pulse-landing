# Site
SEO_SITE_URL=https://www.pentridgemedia.com
SEO_MAX_URLS=30
SEO_RUN_PAGESPEED=false

# Report output
SEO_OUTPUT_DIR=Pentridge AI Search Sprint/06 Reports

# Google APIs
# Keep this JSON key outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
GSC_SITE_URL=sc-domain:pentridgemedia.com
GA4_PROPERTY_ID=

# Disabled by default because these can be slower or mutate external systems.
SEO_RUN_URL_INSPECTION=false
SEO_SUBMIT_GSC_SITEMAP=false

# Bing Webmaster Tools
BING_SITE_URL=https://www.pentridgemedia.com
BING_WEBMASTER_API_KEY=
SEO_SUBMIT_BING_URLS=false

# Optional IndexNow
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
SEO_SUBMIT_INDEXNOW=false
